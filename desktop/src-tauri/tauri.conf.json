{
  "$schema": "https://schema.tauri.app/config/v2/schema.json",
  "productName": "Orion",
  "version": "0.3.0",
  "identifier": "com.vorpal.orion",

  "build": {
    "frontendDist": "../../current"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORION.EXE // The Great Dawn",
        "width": 1180,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
